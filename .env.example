# ============================================
# Keyword Finder - Environment Configuration
# ============================================
# Copy this file to '.env' and fill in your credentials
# DO NOT commit the actual .env file to version control

# --------------------------------------------
# DataForSEO API Credentials (Optional)
# --------------------------------------------
# Get your credentials from: https://app.dataforseo.com/api-access
# Note: These are API credentials, NOT your account login
DATAFORSEO_API_LOGIN=your_api_login_here
DATAFORSEO_API_PASSWORD=your_api_password_here

# --------------------------------------------
# Proxy Settings for Google API (Optional)
# --------------------------------------------
# PRIORITY: proxies.txt file > Environment variables
#
# Method 1 (Recommended): Create proxies.txt file in project root
# Format (one per line): IP:PORT:USERNAME:PASSWORD
# Example: 142.111.48.253:7030:username:password
#
# Method 2: Use environment variables (legacy)
GOOGLE_HTTP_PROXY=
GOOGLE_HTTPS_PROXY=
GOOGLE_PROXIES_ROTATION=

# --------------------------------------------
# Application Settings
# --------------------------------------------
# Port number for the Flask application
FLASK_PORT=5000

# Debug mode (set to 'false' in production)
FLASK_DEBUG=true

# --------------------------------------------
# Rate Limiting Settings
# --------------------------------------------
# Delay between Google API requests (in seconds)
# Google recommends ~0.3-0.5 seconds to avoid rate limiting
# Can be reduced to 0 when using proxies
GOOGLE_REQUEST_DELAY=0.3
